# =============================================================================
# CUDA toolkit qiskit-aer is compiled with (12.6.3, pinned by digest).
#
# Aer links the CUDA runtime.
# Host driver must support this major version. 12.x is kept, for wider compatibility;
# version 13.x drops Pascal support.
#
# Build the CUDA toolchain to compile qiskit-aer for GPU, plus the venv.
# =============================================================================
FROM nvidia/cuda:12.6.3-devel-ubuntu24.04@sha256:392c0df7b577ecae17a17f6ba7f2009c217bb4422f8431c053ae9af61a8c148a AS builder

# GPU generations aer is compiled for.
#
# A build for X.y runs on every X.z with z >= y, and 9.0+PTX lets the driver
# compile for anything newer.
#
# To build for a single arch:
#   docker build --build-arg CUDA_ARCH="6.1" .

# To confirm arch:
#  nvidia-smi --query-gpu=compute_cap --format=csv
ARG CUDA_ARCH="6.1 7.0 8.0 9.0+PTX"
# Must equal qiskit-aer in pdm.lock (checked in the runtime venv step).
ARG AER_VERSION="0.17.2"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git build-essential \
    python3.12-venv python3-dev libopenblas-dev liblapack-dev \
    && rm -rf /var/lib/apt/lists/*

# Compile aer. Side venv, so that it does not reach the image.
#
# Hashed build tools only; runtime deps come from the image venv.
# Exported from docker/aer/pdm.lock by `just exports`.
# --
# NOTE: currently no cuQuantum support (cuStateVec, tensor_network). Needs
# sm_70+ and -DAER_PYTHON_CUDA_ROOT with the cuquantum-cu12 wheels in the
# image venv.
#
# TODO: provide that before cloud rollout
COPY docker/aer-build-requirements.txt /tmp/aer-build-requirements.txt
RUN python3.12 -m venv /opt/aerbuild && \
    git clone --depth 1 --branch ${AER_VERSION} https://github.com/Qiskit/qiskit-aer /tmp/qiskit-aer && \
    /opt/aerbuild/bin/pip install --no-cache-dir --require-hashes -r /tmp/aer-build-requirements.txt

WORKDIR /tmp/qiskit-aer

# on PATH: aer's CMake runs the venv's conan to fetch deps
RUN PATH="/opt/aerbuild/bin:$PATH" python ./setup.py bdist_wheel -- \
    -DAER_THRUST_BACKEND=CUDA \
    -DAER_CUDA_ARCH="${CUDA_ARCH}" \
    -DCMAKE_VERBOSE_MAKEFILE=false \
    -DAER_DEBUG=false \
    -DAER_MPI=false \
    --

# The image venv: dependencies first (reusable layer)
# PyPI's CPU aer comes in as a dep, later replaced by the GPU wheel.
RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /tmp/build

# exported from pdm.lock: just exports
COPY docker/requirements.txt ./
RUN grep -q "^qiskit-aer==${AER_VERSION};" requirements.txt || { echo "AER_VERSION=${AER_VERSION} does not match qiskit-aer in docker/requirements.txt (pdm.lock); change both" >&2; exit 1; } && \
    pip install --no-cache-dir --require-hashes -r requirements.txt && \
    pip install --no-cache-dir --force-reinstall --no-deps /tmp/qiskit-aer/dist/*.whl

COPY pyproject.toml README.md LICENSE ./
COPY quantum_pipeline ./quantum_pipeline

# nothing installed at runtime
RUN pip install --no-cache-dir --no-deps . && pip uninstall -y pip

# =============================================================================
# Ubuntu at runtime.
#
# Aer carries its CUDA runtime and the NVIDIA container toolkit injects the driver's
# libcuda, so no CUDA base is needed.
# =============================================================================
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

ENV DEBIAN_FRONTEND=noninteractive

# python3.12: the interpreter the venv was built against;
# libopenblas0 and libgomp1 - aer's only shared-library dependencies
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    python3.12 libopenblas0 libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# same path as in the builder: the venv's scripts and pyvenv.cfg are absolute
COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# The solver writes gen/ and run_configs/ relative to its working directory;
# world-writable, so any --user can run it, root stays the default.
WORKDIR /usr/src/quantum_pipeline
COPY data ./data
RUN chmod 1777 .

ENTRYPOINT ["python", "-m", "quantum_pipeline"]
