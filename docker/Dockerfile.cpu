FROM python:3.14-slim-trixie@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/build
COPY pyproject.toml ./
RUN python -c "import tomllib; print('\n'.join(tomllib.load(open('pyproject.toml', 'rb'))['project']['dependencies']))" \
      > requirements.txt && \
    pip install --no-cache-dir -r requirements.txt

COPY README.md LICENSE ./
COPY quantum_pipeline ./quantum_pipeline

RUN pip install --no-cache-dir --no-deps . && pip uninstall -y pip && rm -rf /tmp/build

ENV PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib

# ensuring files written to gen/ and run_configs/ can be ran by --user
WORKDIR /usr/src/quantum_pipeline
COPY data ./data
RUN chmod 1777 .

ENTRYPOINT ["python", "-m", "quantum_pipeline"]
