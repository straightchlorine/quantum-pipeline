FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/build

# from pdm.lock; with each relock regenerate like this:
#   pdm export -G default -f requirements -o docker/requirements.txt
COPY docker/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY pyproject.toml README.md LICENSE ./
COPY quantum_pipeline ./quantum_pipeline

RUN pip install --no-cache-dir --no-deps . && pip uninstall -y pip && rm -rf /tmp/build

ENV PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib

# ensuring files written to gen/ and run_configs/ can be ran by --user
WORKDIR /usr/src/quantum_pipeline
COPY data ./data
RUN chmod 1777 .

ENTRYPOINT ["python", "-m", "quantum_pipeline"]
