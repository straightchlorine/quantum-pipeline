FROM python:3.12-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/build

# exported from pdm.lock: just exports
COPY docker/requirements.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

COPY pyproject.toml README.md LICENSE ./
COPY quantum_pipeline ./quantum_pipeline

RUN pip install --no-cache-dir --no-deps . && pip uninstall -y pip && rm -rf /tmp/build

ENV PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib

# ensuring files written to gen/ and run_configs/ can be ran by --user
WORKDIR /usr/src/quantum_pipeline
COPY data ./data
RUN chmod 1777 .

ENTRYPOINT ["python", "-m", "quantum_pipeline"]
